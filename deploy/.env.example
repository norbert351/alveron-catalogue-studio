# Copy to deploy/.env, fill with generated secrets, chmod 600.
# This file is read by the MinIO wrapper, the bootstrap script and backups.
POSTGRES_DB=alveron_catalogue
POSTGRES_USER=catalogue
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

MINIO_ROOT_USER=alveron-minio-admin
MINIO_ROOT_PASSWORD=replace-with-openssl-rand-hex-24
MINIO_APP_USER=alveron-library-app
MINIO_APP_PASSWORD=replace-with-openssl-rand-hex-24
MINIO_BUCKET=alveron-library
MINIO_DATA_DIR=/var/www/alveron-library/data/minio
