# Copy to .env.local. These values are local placeholders only.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://catalogue:replace-with-local-password@127.0.0.1:55432/alveron_catalogue

# Required once, for `npm run db:bootstrap`; use a unique password locally.
AUTH_BOOTSTRAP_EMAIL=owner@example.invalid
AUTH_BOOTSTRAP_NAME=Alveron Studio Owner
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-16-characters
SESSION_SECRET=replace-with-at-least-32-random-characters

# `local` stores private files outside `public/`. Production should use S3.
# LOCAL_STORAGE_DIR is resolved to an absolute path anchored to the project (not
# the process cwd), and is refused if it points inside .next/, public/, /tmp/ or
# node_modules/. Point it at a dedicated data directory and back it up.
# Verify with: npm run storage:root
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./.local-data/private
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional. Enables short-lived HMAC-signed original-image links (10 min by
# default) so a browser or image fetcher can open an original without a bearer
# token. 32+ random characters: openssl rand -hex 32. Bearer auth still works.
# Rotating it invalidates every outstanding signed link.
LIBRARY_SIGNING_SECRET=

# Generation remains disabled until a real provider adapter is implemented.
# Verified providers: fal-kontext (FAL FLUX Kontext, image-to-image), fal-kontext-max.
# A vision-only model must never be set here: it cannot synthesise an image.
IMAGE_GENERATION_PROVIDER=none
# Required when IMAGE_GENERATION_PROVIDER is a fal-* provider. Server-side only.
FAL_KEY=
# How long to wait for a queued generation before the job is retried.
IMAGE_GENERATION_TIMEOUT_SECONDS=180

# Qwen vision: VISUAL UNDERSTANDING ONLY (attribute extraction + fidelity review).
# Verified: hackathon.bitgetops.com/v1 serves qwen3.8-max with base64 image input.
# This endpoint has no image-generation route; do not point a generator at it.
QWEN_VISION_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_VISION_MODEL=qwen3.8-max
QWEN_VISION_API_KEY=

# Private server-side vision bridge (scripts/vision-bridge.mjs). This is not a
# public endpoint. OPENAI_API_KEY is sent only to OpenAI. The read-only library
# token is sent only to ALVERON_LIBRARY_BASE_URL and is never forwarded to
# OpenAI. Sending image bytes to OpenAI is a paid data-transfer action; only run
# the live test with explicit approval (VISION_LIVE_APPROVED=yes).
OPENAI_API_KEY=
# Must be a model that accepts image input, for example a current vision model
# confirmed in your OpenAI account. This bridge does not guess or hardcode one.
OPENAI_VISION_MODEL=
ALVERON_LIBRARY_TOKEN=
ALVERON_LIBRARY_BASE_URL=http://127.0.0.1:3001
ALVERON_LIBRARY_TIMEOUT_MS=45000
VISION_MAX_IMAGES=4
VISION_MAX_IMAGE_BYTES=20971520
VISION_TIMEOUT_MS=45000
VISION_MAX_CALLS_PER_MINUTE=10
VISION_MAX_OUTPUT_TOKENS=800
VISION_MAX_QUESTION_CHARS=2000
# low, high, original or auto. `original` is not supported by every model.
VISION_IMAGE_DETAIL=auto
