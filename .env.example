# Copy to .env.local. These values are local placeholders only.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://catalogue:replace-with-local-password@127.0.0.1:55432/alveron_catalogue

# Required once, for `npm run db:bootstrap`; use a unique password locally.
AUTH_BOOTSTRAP_EMAIL=owner@example.invalid
AUTH_BOOTSTRAP_NAME=Alveron Studio Owner
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-16-characters
SESSION_SECRET=replace-with-at-least-32-random-characters

# `local` stores private files outside `public/`. Production should use S3.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./.local-data/private
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Generation remains disabled until a real provider adapter is implemented.
IMAGE_GENERATION_PROVIDER=none
